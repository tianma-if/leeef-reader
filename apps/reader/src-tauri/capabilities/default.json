{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "webviews": ["*"],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    "process:allow-restart",
    "updater:default",
    "native-bridge:default"
  ]
}
