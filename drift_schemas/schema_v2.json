          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" TEXT NOT NULL, \"sha256\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"author\" TEXT NULL, \"description\" TEXT NULL, \"media_type\" TEXT NOT NULL, \"file_path\" TEXT NULL, \"cover_path\" TEXT NULL, \"is_available_locally\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_available_locally\" IN (0, 1)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
